<?xml version="1.0"?>

<robot name="box_bot">

  <!-- ========================================================= -->
  <!-- BASE BODY                                                  -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.6 0.5"/>
      </geometry>

      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.6 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <mass value="2.0"/>

      <inertia
        ixx="0.135"
        ixy="0.0"
        ixz="0.0"
        iyy="0.208"
        iyz="0.0"
        izz="0.287"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- LEFT WHEEL                                                  -->
  <!-- ========================================================= -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>

      <material name="left_wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>

      <inertia
        ixx="0.003"
        ixy="0.0"
        ixz="0.0"
        iyy="0.003"
        iyz="0.0"
        izz="0.006"/>
    </inertial>

  </link>


  <!-- LEFT WHEEL JOINT -->

  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="0 0.40 0.18" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- RIGHT WHEEL                                                 -->
  <!-- ========================================================= -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>

      <material name="right_wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>

      <inertia
        ixx="0.003"
        ixy="0.0"
        ixz="0.0"
        iyy="0.003"
        iyz="0.0"
        izz="0.006"/>
    </inertial>

  </link>


  <!-- RIGHT WHEEL JOINT -->

  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="0 -0.40 0.18" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- CASTER WHEEL                                                -->
  <!-- ========================================================= -->

  <link name="caster_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>

      <material name="caster_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>

      <inertia
        ixx="0.0004"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0004"
        iyz="0.0"
        izz="0.0004"/>
    </inertial>

  </link>


  <!-- CASTER JOINT -->

  <joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel_link"/>

    <origin xyz="0.48 0 0.10" rpy="0 0 0"/>

  </joint>


</robot>