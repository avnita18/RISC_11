<?xml version="1.0"?>

<robot name="box_bot">

  <!-- ================================================= -->
  <!-- BASE -->
  <!-- ================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.5 0.5"/>
      </geometry>

      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.5 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="1.0"/>

      <inertia
        ixx="0.10417"
        ixy="0.0"
        ixz="0.0"
        iyy="0.10417"
        iyz="0.0"
        izz="0.16667"/>
    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- RIGHT WHEEL -->
  <!-- ================================================= -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>

      <material name="right_wheel_color">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>

      <inertia
        ixx="0.0005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00072"
        iyz="0.0"
        izz="0.0005"/>
    </inertial>

  </link>


  <joint name="base_right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="-0.15 -0.30 0.15" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- LEFT WHEEL -->
  <!-- ================================================= -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>

      <material name="left_wheel_color">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.15"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>

      <inertia
        ixx="0.0005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00072"
        iyz="0.0"
        izz="0.0005"/>
    </inertial>

  </link>


  <joint name="base_left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="-0.15 0.30 0.15" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- CASTER WHEEL -->
  <!-- ================================================= -->

  <link name="caster_wheel_link">

    <visual>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>

      <material name="caster_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>

      <inertia
        ixx="0.00013"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00013"
        iyz="0.0"
        izz="0.00013"/>
    </inertial>

  </link>


  <joint name="base_caster_wheel_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel_link"/>

    <origin xyz="0.35 0 0.08" rpy="0 0 0"/>

  </joint>

</robot>